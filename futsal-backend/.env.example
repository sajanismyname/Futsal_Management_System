NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/futsal_management
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP or Resend HTTP API on port 443)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=noreply@futsalmanagement.com
REQUIRE_EMAIL_VERIFICATION=true
MOCK_EMAIL=false
RESEND_API_KEY=your_resend_api_key_here

# Payment Gateways (Nepal)
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_API_URL=https://a.khalti.com/api/v2
KHALTI_BASE_URL=https://a.khalti.com/api/v2
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
MOCK_PAYMENT=true

# SMS Service (Sparrow SMS)
SPARROW_SMS_TOKEN=your_sparrow_sms_token

# Frontend URL
FRONTEND_URL=http://localhost:5173
